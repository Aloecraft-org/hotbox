# Merge into ~/.config/containers/registries.conf. Docker needs no equivalent.

# localhost:5000 is deliberately not in the search list: hotbox images are
# always pulled by their full tag, and a second search registry makes short
# names like debian:bookworm-slim ambiguous. The block below is what makes
# plain-HTTP pulls from the local registry work.
unqualified-search-registries = ["docker.io"]

[[registry]]
location = "localhost:5000"
insecure = true
